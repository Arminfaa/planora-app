# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27018/project_management?replicaSet=rs0

# JWT (Step 5)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth rate limiting (production only, login/register)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Upload
MAX_FILE_SIZE=5242880
MAX_IMAGE_SIZE=2097152
