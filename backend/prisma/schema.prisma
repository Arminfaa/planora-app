generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

enum PermissionMode {
  DEFAULT
  CUSTOM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentType {
  IMAGE
  FILE
}

enum ProjectGroupMessageType {
  USER
  ACTIVITY
}

// ─── User ────────────────────────────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  sentInvites   ProjectInvite[] @relation("InviteSender")
  createdTasks  Task[]          @relation("TaskCreator")
  comments            Comment[]
  projectGroupMessages ProjectGroupMessage[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Project ─────────────────────────────────────────────

model Project {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String         @unique
  description    String?
  ownerId        String         @db.ObjectId
  permissionMode PermissionMode @default(DEFAULT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner           User                    @relation("ProjectOwner", fields: [ownerId], references: [id])
  members         ProjectMember[]
  invites         ProjectInvite[]
  boards          Board[]
  labels          Label[]
  roleDefinitions     ProjectRoleDefinition[]
  groupMessages       ProjectGroupMessage[]

  @@map("projects")
}

model ProjectRoleDefinition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  name        String
  permissions String[]
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id])
  members ProjectMember[]
  invites ProjectInvite[]

  @@unique([projectId, name])
  @@map("project_role_definitions")
}

model ProjectMember {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String      @db.ObjectId
  userId           String      @db.ObjectId
  role             ProjectRole @default(MEMBER)
  roleDefinitionId String?     @db.ObjectId
  joinedAt         DateTime    @default(now())

  project        Project                @relation(fields: [projectId], references: [id])
  user           User                   @relation(fields: [userId], references: [id])
  roleDefinition ProjectRoleDefinition? @relation(fields: [roleDefinitionId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectInvite {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String      @db.ObjectId
  email            String
  role             ProjectRole @default(MEMBER)
  roleDefinitionId String?     @db.ObjectId
  token            String      @unique
  invitedBy        String      @db.ObjectId
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime    @default(now())

  project        Project                @relation(fields: [projectId], references: [id])
  inviter        User                   @relation("InviteSender", fields: [invitedBy], references: [id])
  roleDefinition ProjectRoleDefinition? @relation(fields: [roleDefinitionId], references: [id])

  @@index([projectId, email])
  @@map("project_invites")
}

// ─── Board (Kanban) ──────────────────────────────────────

model Board {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  name                      String
  slug                      String
  projectId                 String   @db.ObjectId
  position                  Int      @default(0)
  backgroundUrl             String?
  backgroundStorageKey      String?
  backgroundStorageProvider String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id])
  columns Column[]

  @@unique([projectId, slug])
  @@map("boards")
}

model Column {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  boardId   String   @db.ObjectId
  position  Int      @default(0)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id])
  tasks Task[]

  @@map("columns")
}

// ─── Task ────────────────────────────────────────────────

model Task {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String
  description String?
  columnId    String       @db.ObjectId
  boardId     String       @db.ObjectId
  position    Int          @default(0)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  isCompleted  Boolean      @default(false)
  assigneeIds  String[]     @db.ObjectId
  createdById String       @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  column         Column              @relation(fields: [columnId], references: [id])
  createdBy      User                @relation("TaskCreator", fields: [createdById], references: [id])
  labels         TaskLabel[]
  comments       Comment[]
  attachments    Attachment[]
  checklistItems TaskChecklistItem[]

  @@unique([boardId, slug])
  @@map("tasks")
}

model TaskChecklistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklist_items")
}

// ─── Label ───────────────────────────────────────────────

model Label {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String @default("#6B7280")
  projectId String @db.ObjectId

  project Project     @relation(fields: [projectId], references: [id])
  tasks   TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model TaskLabel {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  taskId  String @db.ObjectId
  labelId String @db.ObjectId

  task  Task  @relation(fields: [taskId], references: [id])
  label Label @relation(fields: [labelId], references: [id])

  @@unique([taskId, labelId])
  @@map("task_labels")
}

// ─── Comment ─────────────────────────────────────────────

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  taskId    String   @db.ObjectId
  authorId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ─── Attachment ──────────────────────────────────────────

model Attachment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  filename        String
  url             String
  mimeType        String
  size            Int
  type            AttachmentType
  storageKey      String?
  storageProvider String?        @default("local")
  taskId          String         @db.ObjectId
  createdAt       DateTime       @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@map("attachments")
}

// ─── Project Group (chat + activity feed) ─────────────────

model ProjectGroupMessage {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String                  @db.ObjectId
  type         ProjectGroupMessageType @default(USER)
  content      String?
  authorId     String?                 @db.ObjectId
  activityType String?
  activityData Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  editedAt     DateTime?

  project     Project                  @relation(fields: [projectId], references: [id])
  author      User?                    @relation(fields: [authorId], references: [id])
  attachments ProjectGroupAttachment[]

  @@index([projectId, createdAt])
  @@map("project_group_messages")
}

model ProjectGroupAttachment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  messageId       String         @db.ObjectId
  filename        String
  url             String
  mimeType        String
  size            Int
  type            AttachmentType
  storageKey      String?
  storageProvider String?        @default("local")
  createdAt       DateTime       @default(now())

  message ProjectGroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("project_group_attachments")
}
