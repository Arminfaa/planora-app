# Browser API (same-origin via Next.js rewrite)
NEXT_PUBLIC_API_URL=/api/v1

# Backend target for Next.js rewrites (server-side only)
BACKEND_API_URL=http://localhost:5000/api/v1

# Socket.io — leave unset in production (same-origin via /socket.io rewrite).
# For local dev you can set this to the backend origin if needed:
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# App
NEXT_PUBLIC_APP_NAME=Planora

# Web Push uses VAPID keys from the backend API (/notifications/push/vapid-key).
# Production requires HTTPS and VAPID_* env vars on the backend.
