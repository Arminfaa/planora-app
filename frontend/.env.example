# Browser API (same-origin via Next.js rewrite)
NEXT_PUBLIC_API_URL=/api/v1

# Backend target for Next.js rewrites (server-side only)
BACKEND_API_URL=http://localhost:5000/api/v1

# Socket.io (direct to backend — cookies are shared on localhost)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# App
NEXT_PUBLIC_APP_NAME=Project Management Platform
