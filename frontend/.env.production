# Production — https://project-management-platform-last.vercel.app
# Copy these into Vercel → Project → Settings → Environment Variables (Production)

# Browser API (same-origin via Next.js rewrite — keeps auth cookies on Vercel domain)
NEXT_PUBLIC_API_URL=/api/v1

# Backend target for Next.js rewrites (server-side only)
BACKEND_API_URL=https://project-management-platform-2465.onrender.com/api/v1

# Socket.io — leave unset so the browser connects same-origin via /socket.io rewrite
# (cookies stay on the Vercel domain; required for mobile Safari / cross-site rules)
# NEXT_PUBLIC_SOCKET_URL=

# App
NEXT_PUBLIC_APP_NAME=Planora
