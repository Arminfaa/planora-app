{
  "name": "project-management-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack project management platform with Kanban boards and real-time collaboration",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n mongo,backend,frontend -c yellow,blue,green \"npm run db:start -w backend\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "start:backend": "npm run start -w backend",
    "start:frontend": "npm run start -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "test": "npm run test:smoke -w backend",
    "test:smoke": "npm run test:smoke -w backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:studio": "npm run prisma:studio -w backend",
    "db:init": "npm run db:init -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:setup": "npm run db:init -w backend && npm run prisma:push -w backend && npm run db:seed -w backend"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "eslint --fix --config backend/eslint.config.mjs --no-warn-ignored",
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
